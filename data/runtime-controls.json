{
  "policyVersion": "2026-08-29",
  "rules": [
    {
      "name": "NODE_OPTIONS",
      "match": "exact",
      "platforms": ["all"],
      "runtimes": ["node"],
      "category": "runtime-loader",
      "scope": "all",
      "reason": "Changes Node startup behavior and can preload executable modules.",
      "evidence": ["https://nodejs.org/api/cli.html#node_optionsoptions"]
    },
    {
      "name": "NODE_PATH",
      "match": "exact",
      "platforms": ["all"],
      "runtimes": ["node"],
      "category": "module-resolution",
      "scope": "all",
      "reason": "Adds global module search paths used by Node resolution.",
      "evidence": [
        "https://nodejs.org/api/modules.html#loading-from-the-global-folders"
      ]
    },
    {
      "name": "NODE_EXTRA_CA_CERTS",
      "match": "exact",
      "platforms": ["all"],
      "runtimes": ["node"],
      "category": "trust-store",
      "scope": "overlay",
      "reason": "Extends Node's trusted certificate authorities from a named file.",
      "evidence": ["https://nodejs.org/api/cli.html#node_extra_ca_certsfile"]
    },
    {
      "name": "NODE_REDIRECT_WARNINGS",
      "match": "exact",
      "platforms": ["all"],
      "runtimes": ["node"],
      "category": "filesystem-output",
      "scope": "overlay",
      "reason": "Redirects Node warnings to a named file.",
      "evidence": ["https://nodejs.org/api/cli.html#node_redirect_warningsfile"]
    },
    {
      "name": "NODE_V8_COVERAGE",
      "match": "exact",
      "platforms": ["all"],
      "runtimes": ["node"],
      "category": "filesystem-output",
      "scope": "overlay",
      "reason": "Directs Node to write V8 coverage data to a named directory.",
      "evidence": ["https://nodejs.org/api/cli.html#node_v8_coveragedir"]
    },
    {
      "name": "LD_PRELOAD",
      "match": "exact",
      "platforms": ["linux", "freebsd"],
      "runtimes": ["native-loader"],
      "category": "runtime-loader",
      "scope": "all",
      "reason": "Requests shared objects be loaded before program libraries.",
      "evidence": ["https://man7.org/linux/man-pages/man8/ld.so.8.html"]
    },
    {
      "name": "LD_AUDIT",
      "match": "exact",
      "platforms": ["linux", "freebsd"],
      "runtimes": ["native-loader"],
      "category": "runtime-loader",
      "scope": "all",
      "reason": "Requests loader audit libraries in a separate namespace.",
      "evidence": ["https://man7.org/linux/man-pages/man8/ld.so.8.html"]
    },
    {
      "name": "LD_LIBRARY_PATH",
      "match": "exact",
      "platforms": ["linux", "freebsd"],
      "runtimes": ["native-loader"],
      "category": "library-resolution",
      "scope": "all",
      "reason": "Changes the native shared-library search path.",
      "evidence": ["https://man7.org/linux/man-pages/man8/ld.so.8.html"]
    },
    {
      "name": "LD_PROFILE",
      "match": "exact",
      "platforms": ["linux"],
      "runtimes": ["native-loader"],
      "category": "filesystem-output",
      "scope": "overlay",
      "reason": "Selects a shared object for loader profiling output.",
      "evidence": ["https://man7.org/linux/man-pages/man8/ld.so.8.html"]
    },
    {
      "name": "DYLD_",
      "match": "prefix",
      "platforms": ["darwin"],
      "runtimes": ["native-loader"],
      "category": "runtime-loader",
      "scope": "all",
      "reason": "The documented DYLD namespace controls dynamic loader paths and inserted libraries.",
      "evidence": ["https://keith.github.io/xcode-man-pages/dyld.1.html"]
    },
    {
      "name": "GCONV_PATH",
      "match": "exact",
      "platforms": ["linux"],
      "runtimes": ["glibc"],
      "category": "module-resolution",
      "scope": "all",
      "reason": "Changes glibc character-set conversion module lookup.",
      "evidence": ["https://man7.org/linux/man-pages/man8/iconvconfig.8.html"]
    },
    {
      "name": "GLIBC_TUNABLES",
      "match": "exact",
      "platforms": ["linux"],
      "runtimes": ["glibc"],
      "category": "runtime-configuration",
      "scope": "overlay",
      "reason": "Changes glibc runtime tunables before the program starts.",
      "evidence": [
        "https://www.gnu.org/software/libc/manual/html_node/Tunables.html"
      ]
    },
    {
